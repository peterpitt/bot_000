# 複製成 .env 後填寫；.env 已列入 .gitignore，不會被提交

# --- 登入（容器對外時必填）---
APP_USER=owner
APP_PASSWORD=

# --- Grok（xAI）---
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Supabase ---
# 專案網址：Supabase 後台 → Project Settings → Data API
SUPABASE_URL=https://uvjastvnrzbzcssznyum.supabase.co
# 伺服器專用金鑰：Project Settings → API Keys → Secret keys（sb_secret_...）
# 也可用舊版 service_role key。絕對不要放進網頁或提交到 Git。
SUPABASE_SECRET_KEY=

# --- 公司帳本 ---
FIRM_ID=default
FIRM_NAME=宇宙行星顧問

# --- 建置（選用）---
# Docker Hub 回 429 限流時改用鏡像
# PYTHON_IMAGE=mirror.gcr.io/library/python:3.12-slim
